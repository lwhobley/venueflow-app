{
  "name": "venue-wrangler",
  "private": true,
  "main": "expo-router/entry",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "brace-expansion@^1.1.7": "1.1.18",
    "brace-expansion@^5.0.5": "5.0.9",
    "js-yaml": "4.3.1",
    "postcss": "8.5.25",
    "uuid": "11.1.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "api:dev": "npm run start:dev -w @venue-wrangler/api",
    "api:build": "npm run build -w @venue-wrangler/api",
    "api:prisma:generate": "npm run prisma:generate -w @venue-wrangler/api",
    "api:migrate:dev": "npm run prisma:migrate:dev -w @venue-wrangler/api",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@tanstack/react-query": "^5.59.0",
    "expo": "~54.0.36",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "29.0.19",
    "fast-uri": "^3.1.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-paper": "^5.12.0",
    "react-native-purchases": "^10.1.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.0",
    "undici": "^8.9.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3",
    "@types/react": "~19.1.10",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "~5.9.2",
    "vitest": "^4.1.9"
  }
}
