EXPO_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Set to true after Stripe billing is configured. When false/unset, the app
# runs free-tier and the SubscriptionGate never locks users out.
EXPO_PUBLIC_BILLING_ENABLED=false

# Public app URL used by Stripe Checkout/Portal return links.
APP_PUBLIC_URL=https://your-app.example.com

# Stripe Billing integration.
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# POS webhook integration.
POS_WEBHOOK_SECRET=replace-with-a-long-random-token

# Reservation provider webhook integration.
RESERVATION_WEBHOOK_SECRET=replace-with-a-long-random-token

# Push notification delivery through a0.
A0_SERVER_KEY=your-a0-server-key
