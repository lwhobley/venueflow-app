EXPO_PUBLIC_API_URL=http://localhost:4000/api

# API runtime configuration (use Supabase/Cloud Run values in production).
DATABASE_URL=postgresql://postgres:password@localhost:5432/venuewrangler
DATABASE_DIRECT_URL=postgresql://postgres:password@localhost:5432/venuewrangler
# Keep this small for Supabase's session pooler. Scale Cloud Run instances
# against the combined connection budget rather than increasing this blindly.
DATABASE_POOL_SIZE=5
JWT_SECRET=replace-with-a-long-random-secret
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local-placeholder
AWS_SECRET_ACCESS_KEY=local-placeholder
AWS_S3_BUCKET=venuewrangler-chat-images

# Number of trusted reverse-proxy hops in front of the API (Express "trust
# proxy" setting). Determines which X-Forwarded-For entry is treated as the
# real client IP for rate-limit keys. Verify this against the actual
# deployment topology — an incorrect value can either collapse all clients
# into one rate-limit bucket or let a client spoof its IP.
TRUST_PROXY_HOPS=1

# Browser origins allowed to call the API. Use explicit http(s) origins, not "*",
# because the API enables credentialed CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,https://venuewrangler.com,https://www.venuewrangler.com

# Set to true to enable RevenueCat billing gates. When false/unset, the app
# runs free-tier and the SubscriptionGate never locks users out.
EXPO_PUBLIC_BILLING_ENABLED=false

# RevenueCat SDK Keys (iOS in-app purchases only).
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=pro
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx

# Optional: set this in RevenueCat webhook authorization as a Bearer token.
REVENUECAT_WEBHOOK_SECRET=replace-with-a-long-random-token
REVENUECAT_API_KEY=replace-with-revenuecat-secret-api-key

# Stripe (web checkout). STRIPE_PRICE_ID / STRIPE_MULTI_VENUE_PRICE_ID should
# be set once the corresponding prices exist in the Stripe dashboard. In
# production these are REQUIRED — the API refuses to auto-create a price at
# checkout time there (doing so would silently recreate a new price at the
# hardcoded fallback amount if the dashboard price were ever archived to
# change pricing). Outside production, leaving them unset falls back to
# resolving/creating the price at request time as a bootstrap convenience.
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=
STRIPE_MULTI_VENUE_PRICE_ID=
# Base URL used to build Stripe checkout/portal success/cancel/return links.
# Defaults to https://venuewrangler.com if unset.
WEB_BASE_URL=

# Transactional email delivery through Resend.
RESEND_API_KEY=re_xxx
EMAIL_FROM="Venue Wrangler <no-reply@venuewrangler.com>"

# Gemini is used by all AI-assisted scheduling, staff-import, and inventory features.
GEMINI_API_KEY=replace-with-a-google-ai-studio-key
GEMINI_MODEL=gemini-flash-latest
# AI spend guardrails. Keep the request reservation conservative enough to
# cover the largest enabled AI request for a venue.
AI_MONTHLY_VENUE_BUDGET_USD=10
AI_MONTHLY_VENUE_WARNING_PERCENT=80
AI_MAX_OUTPUT_TOKENS=2048
AI_BUDGET_RESERVATION_TTL_SECONDS=120
AI_COST_INPUT_PER_MILLION_USD=
AI_COST_OUTPUT_PER_MILLION_USD=

# Error tracking (optional). When unset, Sentry stays disabled and the app runs
# normally; set this in production to capture 5xx errors.
SENTRY_DSN=

# Signing secret for short-lived chat-image/checklist-photo access tokens
# (see MediaAccessService). Falls back to JWT_SECRET if unset; set this
# separately so media tokens can be rotated without invalidating every
# active session.
MEDIA_TOKEN_SECRET=

# Tenant-isolation database backstop. Enforced by default (any value other than
# the literal string "false") — the Prisma extension AND-scopes venue-owned
# models to the request's tenant and forces venueId onto creates. Set to
# "false" only to roll back instantly if the extension itself is suspected of
# causing a production issue.
TENANT_ISOLATION_ENFORCED=

# ─── Device attestation (Apple App Attest) ───────────────────────────────────
# The geofenced time clock validates lat/lng/mocked that the CLIENT supplies, so
# without attestation any holder of a valid token can post the venue's
# coordinates from anywhere. App Attest proves the request came from a genuine,
# unmodified build of the app on real Apple hardware.
#
# ROLLOUT IS STAGED ON PURPOSE. Leave ATTESTATION_ENFORCED unset/false until the
# iOS build that produces assertions has reached your install base: turning it on
# early locks every older app version out of clocking in. While it is false the
# server still verifies any assertion it receives and logs failures, which is how
# you measure readiness (watch for "App Attest assertion rejected" warnings).
ATTESTATION_ENFORCED=
# Apple Developer Team ID (10 characters). Required — attestation fails closed
# without it once enforcement is on.
APP_ATTEST_TEAM_ID=
# Defaults to com.venuewrangler.app; override only if the bundle id changes.
APP_ATTEST_BUNDLE_ID=
# Accept attestations from Apple's development environment. Ignored (always
# false) when NODE_ENV=production — a development attestation can be produced
# from a debug build and must never authorise a real punch.
APP_ATTEST_ALLOW_DEVELOPMENT=
