EXPO_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Set to true after Stripe billing is configured. When false/unset, the app
# runs free-tier and the SubscriptionGate never locks users out.
EXPO_PUBLIC_BILLING_ENABLED=false

# Public app URL used by Stripe Checkout/Portal return links.
APP_PUBLIC_URL=https://your-app.example.com

# Stripe Billing integration.
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe price IDs and payment links — set these in the Convex dashboard
# (Settings → Environment Variables) so they are never committed to source.
STRIPE_STARTER_PRICE_ID=price_xxx
STRIPE_GROWTH_PRICE_ID=price_xxx
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_STARTER_PAYMENT_LINK=https://buy.stripe.com/xxx
STRIPE_GROWTH_PAYMENT_LINK=https://buy.stripe.com/xxx
STRIPE_PRO_PAYMENT_LINK=https://buy.stripe.com/xxx

# POS webhook integration.
POS_WEBHOOK_SECRET=replace-with-a-long-random-token

# Reservation provider webhook integration.
RESERVATION_WEBHOOK_SECRET=replace-with-a-long-random-token

# Push notification delivery through a0.
A0_SERVER_KEY=your-a0-server-key

# AI-assisted Bar Stock parsing.
OPENAI_API_KEY=sk-proj_xxx
OPENAI_INVENTORY_MODEL=gpt-4.1-mini

# Demo mode. Set DEMO_ENABLED=true to expose the bootstrapDemo mutation.
# Override credentials from defaults; set these in the Convex dashboard,
# never commit real values here.
DEMO_ENABLED=false
DEMO_EMAIL=demo@venueflow.app
DEMO_PASSWORD=demopass1
