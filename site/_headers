# Cloudflare Pages security headers for the static marketing/join site.
# script-src/style-src keep 'unsafe-inline' because the pages ship inline
# scripts and <style> blocks; the remaining directives still block framing,
# object embeds, and cross-origin exfiltration to anything but the API.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://venue-wrangler-api-c57mm72zpa-ue.a.run.app; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
