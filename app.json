{
  "expo": {
    "name": "Venue Wrangler",
    "slug": "venue-wrangler",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/venue-wrangler-logo.jpg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/venue-wrangler-logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#F4FAFC"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/venue-wrangler-logo.jpg",
        "backgroundColor": "#F4FAFC"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/venue-wrangler-logo.jpg"
    },
    "scheme": "venuewrangler",
    "description": "Venue Wrangler restaurant operations and venue management.",
    "extra": {
      "EXPO_PUBLIC_CONVEX_URL": "https://dashing-eel-31.convex.cloud"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
