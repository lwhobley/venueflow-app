# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
web-dist/
expo-env.d.ts
packages/*/dist/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Generated auth keys (contain a private key — never commit)
scripts/.auth-keys.json

# Local tooling artifacts (Claude Code, Codex, agent runners)
.claude/
.codex/
.agents/
.vs/

# Build artifacts and assets
builds/
facebook-assets/
screenshots/

