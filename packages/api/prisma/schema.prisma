generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  owner
  manager
  server
  staff
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  expired
  paused
}

enum SubscriptionPlatform {
  stripe
  apple
}

enum ShiftStatus {
  scheduled
  open
  covered
}

enum RequestStatus {
  pending
  approved
  denied
  cancelled
}

enum TableShape {
  round
  square
  rect
  booth
}

enum TableSection {
  main
  patio
  bar
  vip
}

enum TableStatus {
  available
  seated
  dirty
  reserved
  held
  out_of_service
}

enum ReservationStatus {
  requested
  confirmed
  checked_in
  seated
  completed
  no_show
  cancelled
}

enum ReservationSource {
  direct
  opentable
  resy
  phone
  walk_in
  sevenrooms
  tock
  google
  generic
}

enum PosProvider {
  toast
  square
  clover
  generic
}

enum IntegrationStatus {
  connected
  paused
  error
}

enum PosCheckStatus {
  open
  paid
  void
}

enum WaitlistStatus {
  waiting
  assigned
  seated
  completed
  removed
}

enum HoldType {
  reserved
  held
  seated
}

enum CrmLeadStatus {
  new
  contacted
  qualified
  proposal_sent
  negotiating
  won
  lost
  unqualified
  on_hold
}

enum BeoStatus {
  draft
  sent
  reviewed
  confirmed
  amended
  cancelled
}

enum ContractStatus {
  draft
  sent
  viewed
  partially_signed
  fully_signed
  expired
  cancelled
  disputed
}

enum BarStockCategory {
  spirit
  wine
  beer
  mixer
  garnish
  supply
  other
}

enum BarStockMovementType {
  count
  received
  waste
  comp
  transfer
  correction
}

enum ManagerGoalPeriod {
  day
  week
}

enum ManagerGoalStatus {
  open
  done
  cancelled
}

enum MembershipStatus {
  pending
  active
  rejected
  revoked
}

enum WorkplaceJoinRequestStatus {
  pending
  approved
  rejected
  cancelled
}

model User {
  id                        String                 @id @default(cuid())
  email                     String?                @unique
  phone                     String?                @unique
  emailVerifiedAt           DateTime?
  emailVerificationCodeHash String?
  emailVerificationSentAt   DateTime?
  passwordResetCodeHash     String?
  passwordResetExpiresAt    DateTime?
  passwordResetSentAt       DateTime?
  failedSignInCount         Int                    @default(0)
  lockedUntil               DateTime?
  createdAt                 DateTime               @default(now())
  // userId is unique on Profile, so this is effectively one-to-one.
  profile                   Profile?
  sessions                  Session[]
  accounts                  AuthAccount[]
  password                  PasswordCredential?
  joinRequests              WorkplaceJoinRequest[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String?  @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId, provider])
}

model PasswordCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  salt         String
  iterations   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Venue {
  id                            String                  @id @default(cuid())
  name                          String
  latitude                      Float
  longitude                     Float
  geofenceRadiusM               Float
  // IANA timezone (e.g. "America/New_York"). Null falls back to UTC; used to
  // bucket daily reports in the venue's business day rather than server time.
  timezone                      String?
  code                          String?                 @unique
  phone                         String?
  address                       String?
  venueType                     String?
  staffRange                    String?
  weeklyLaborBudgetHours        Float?
  schedulePublishedAt           DateTime?
  schedulePublishedById         String?
  scheduleUpdatedAfterPublishAt DateTime?
  // Availability lock window. Staff set availability for upcoming pay periods;
  // a period locks once it begins, unless availabilityUnlocked is set venue-wide.
  payPeriodAnchor               String?
  payPeriodLengthDays           Int                     @default(14)
  availabilityUnlocked          Boolean                 @default(false)
  earlyClockInWindowMin         Int                     @default(10)
  subscriptionStatus            SubscriptionStatus?
  subscriptionPlatform          SubscriptionPlatform?
  leadsWebhookSecret            String?
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  profiles                      Profile[]
  shifts                        ScheduleShift[]
  shiftSwaps                    ShiftSwap[]
  availability                  Availability[]
  conversations                 Conversation[]
  conversationReads             ConversationRead[]
  chatImages                    ChatImage[]
  notifications                 NotificationEvent[]
  pushTokens                    PushToken[]
  timeEntries                   TimeEntry[]
  blackoutDates                 BlackoutDate[]
  staffRequests                 StaffRequest[]
  guests                        Guest[]
  reservations                  Reservation[]
  floorPlans                    FloorPlan[]
  tables                        TableState[]
  subscriptions                 Subscription[]
  crmLeads                      CrmLead[]
  posChecks                     PosCheck[]
  scheduleTemplates             ScheduleTemplate[]
  notificationReads             NotificationRead[]
  waitlistEntries               Waitlist[]
  tableAssignments              TableAssignment[]
  posConnections                PosConnection[]
  posLaborPunches               PosLaborPunch[]
  crmActivityLogs               CrmActivityLog[]
  crmBeos                       CrmBeo[]
  crmContracts                  CrmContract[]
  emailTemplates                EmailTemplate[]
  reservationHolds              ReservationHold[]
  paymentMethods                PaymentMethod[]
  invoices                      Invoice[]
  venueRoles                    VenueRole[]
  teams                         Team[]
  scheduleEmailEvents           ScheduleEmailEvent[]
  payrollExports                PayrollExport[]
  reservationConnections        ReservationConnection[]
  reservationSyncEvents         ReservationSyncEvent[]
  barInventoryItems             BarInventoryItem[]
  barInventoryMovements         BarInventoryMovement[]
  managerGoals                  ManagerGoal[]
  venueEvents                   VenueEvent[]
  reservationSettings           ReservationSetting[]
  tableStateHistory             TableStateHistory[]
  invites                       Invite[]
  joinRequests                  WorkplaceJoinRequest[]
}

model Profile {
  id               String            @id @default(cuid())
  userId           String?           @unique
  tokenIdentifier  String?
  email            String
  fullName         String
  role             Role
  jobTitle         String
  phone            String?
  altPhone         String?
  address          String?
  dateOfBirth      DateTime?
  certifications   String[]          @default([])
  venueId          String?
  membershipStatus MembershipStatus?
  allAccess        Boolean           @default(false)
  sickHoursAccrued Float             @default(40.0)
  ptoHoursAccrued  Float             @default(80.0)
  trialEndsAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  venue            Venue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  shifts           ScheduleShift[]
  availability     Availability[]
  pushTokens       PushToken[]
  timeEntries      TimeEntry[]
  staffRequests    StaffRequest[]
  sentMessages     Message[]
  crmNotes         CrmNote[]

  @@index([venueId])
  @@index([email])
  @@index([tokenIdentifier])
}

model ScheduleShift {
  id           String      @id @default(cuid())
  venueId      String
  profileId    String?
  dayIndex     Int
  startMinutes Int
  endMinutes   Int
  jobTitle     String
  station      String
  notes        String?
  status       ShiftStatus
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  venue        Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  profile      Profile?    @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([venueId])
  @@index([profileId])
  @@index([venueId, profileId, dayIndex])
}

model BlackoutDate {
  id        String   @id @default(cuid())
  venueId   String
  startDate String
  endDate   String
  reason    String
  createdBy String
  createdAt DateTime @default(now())
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model ScheduleTemplate {
  id        String   @id @default(cuid())
  venueId   String
  name      String
  shifts    Json
  createdAt DateTime @default(now())
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model Availability {
  id           String   @id @default(cuid())
  venueId      String
  profileId    String
  // Sunday ('YYYY-MM-DD') of the calendar week this availability applies to.
  weekStart    String
  dayIndex     Int
  startMinutes Int
  endMinutes   Int
  available    Boolean
  updatedAt    DateTime @updatedAt
  venue        Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([venueId])
  @@index([profileId, weekStart])
  @@index([venueId, weekStart])
}

model StaffRequest {
  id                  String        @id @default(cuid())
  venueId             String
  profileId           String
  kind                String
  status              RequestStatus
  title               String
  details             String
  requestedForDate    String?
  requestedShiftId    String?
  requestedRangeStart String?
  requestedRangeEnd   String?
  availability        Json?
  reviewerId          String?
  reviewedAt          DateTime?
  responseNotes       String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  venue               Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  profile             Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([profileId])
  @@index([status])
}

model Conversation {
  id              String    @id @default(cuid())
  venueId         String
  type            String
  name            String?
  memberIds       String[]
  lastMessageAt   DateTime?
  lastMessageText String?
  roleName        String?
  shiftDate       String?
  venue           Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  messages        Message[]
  reads           ConversationRead[]

  @@index([venueId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  venueId        String
  // Nullable + SetNull so the team's chat history survives a member deleting
  // their account; the UI shows a fallback name for missing senders.
  senderId       String?
  text           String
  createdAt      DateTime     @default(now())
  shiftId        String?
  swapId         String?
  imageUrl       String?
  reactions      Json?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         Profile?     @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

model ConversationRead {
  id             String       @id @default(cuid())
  conversationId String
  profileId      String
  venueId        String
  readAt         DateTime     @default(now())
  venue          Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, profileId])
  @@index([conversationId])
}

// S3 store for chat photo attachments. Served via an unguessable
// capability URL (GET /v1/chat/images/:id) that redirects to S3 pre-signed URL.
model ChatImage {
  id         String   @id @default(cuid())
  venueId    String
  mimeType   String
  s3Key      String
  uploadedBy String?
  createdAt  DateTime @default(now())
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model NotificationEvent {
  id        String   @id @default(cuid())
  venueId   String
  profileId String?
  audience  String
  kind      String
  title     String
  body      String
  createdAt DateTime @default(now())
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, createdAt])
  @@index([profileId, createdAt])
}

model NotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  profileId      String
  venueId        String
  readAt         DateTime @default(now())
  venue          Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([notificationId, profileId])
  @@index([profileId])
}

model PushToken {
  id         String   @id @default(cuid())
  venueId    String
  profileId  String
  token      String   @unique
  platform   String
  enabled    Boolean
  lastSeenAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([venueId])
}

// NOTE: a partial unique index exists in SQL only (Prisma cannot express it):
//   TimeEntry_profileId_open_key ON "TimeEntry"("profileId") WHERE "isOpen" = true
// (migration 20260608130000_clock_in_open_unique). If `prisma migrate dev`
// ever generates a DROP for that index, delete that statement before applying.
model TimeEntry {
  id                String    @id @default(cuid())
  venueId           String
  // Nullable + SetNull so wage records survive account deletion (FLSA
  // retention). profileFullName is snapshotted before the profile is removed.
  profileId         String?
  profileFullName   String?
  clockInAt         DateTime
  clockOutAt        DateTime?
  clockInLat        Float
  clockInLng        Float
  clockInAccuracyM  Float
  clockInMocked     Boolean
  clockOutLat       Float?
  clockOutLng       Float?
  clockOutAccuracyM Float?
  clockOutMocked    Boolean?
  isOpen            Boolean
  breaks            Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  venue             Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  profile           Profile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([venueId])
  @@index([venueId, clockInAt])
  @@index([profileId])
  @@index([profileId, isOpen])
  @@index([isOpen])
}

model ShiftSwap {
  id                 String   @id @default(cuid())
  venueId            String
  requesterProfileId String
  requesterShiftId   String
  targetProfileId    String
  targetShiftId      String?
  status             String
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  venue              Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([requesterProfileId])
  @@index([targetProfileId])
}

model Guest {
  id              String    @id @default(cuid())
  venueId         String
  fullName        String
  phone           String?
  email           String?
  lifecycleStage  String?
  source          String?
  birthday        String?
  company         String?
  marketingOptIn  Boolean?
  favoriteTable   String?
  preferredServer String?
  dietaryNotes    String?
  tags            String[]
  notes           String?
  nameLower       String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  venue           Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([phone])
  @@index([email])
  @@index([venueId, nameLower])
}

model Reservation {
  id                  String            @id @default(cuid())
  venueId             String
  guestId             String?
  guestName           String
  guestPhone          String?
  guestEmail          String?
  guestCompany        String?
  partySize           Int
  reservationTime     DateTime
  durationMinutes     Int
  source              ReservationSource
  status              ReservationStatus
  specialRequests     String?
  occasion            String?
  tags                String[]
  isPrivateEvent      Boolean?
  eventName           String?
  eventStatus         String?
  eventSpace          String?
  setupStyle          String?
  menuNotes           String?
  beverageNotes       String?
  billingNotes        String?
  contractStatus      String?
  beoStatus           String?
  estimatedValueCents Int?
  depositDueCents     Int?
  externalId          String?
  toastCheckGuid      String?
  depositStatus       String?
  checkInAt           DateTime?
  seatedAt            DateTime?
  completedAt         DateTime?
  notes               String?
  // Timestamp the reminder email was sent. NULL = not yet reminded; the
  // reminder cron looks for upcoming bookings with this still null.
  reminderSentAt      DateTime?
  // Timestamp the confirmation email was sent (set when status first hits
  // confirmed and guestEmail exists). Prevents duplicate confirmations on
  // status flips.
  confirmationSentAt  DateTime?
  deletedAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  venue               Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, reservationTime])
  @@index([venueId, status])
  @@index([guestId])
  @@index([externalId])
  @@index([venueId, externalId])
  @@index([reminderSentAt, reservationTime])
}

model Waitlist {
  id          String         @id @default(cuid())
  venueId     String
  guestId     String?
  guestName   String
  guestPhone  String?
  guestEmail  String?
  partySize   Int
  source      String
  status      WaitlistStatus
  requestedAt DateTime
  readyAt     DateTime?
  // Set when the auto-notifier emails the guest that a table is ready.
  // Prevents re-notifying on subsequent table releases.
  notifiedAt  DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  venue       Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, requestedAt])
  @@index([venueId, status])
}

// A manager-imposed block on a date/time window so the venue won't accept
// reservations during it (staff meeting, private buyout, deep clean). The
// reservation create path warns when the requested time overlaps a hold.
model ReservationHold {
  id        String   @id @default(cuid())
  venueId   String
  startsAt  DateTime
  endsAt    DateTime
  reason    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, startsAt])
}

model FloorPlan {
  id                 String       @id @default(cuid())
  venueId            String
  name               String
  width              Float
  height             Float
  backgroundImageUrl String?
  isActive           Boolean
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  venue              Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tables             FloorTable[]
  chairs             FloorChair[]

  @@index([venueId])
  @@index([venueId, isActive])
}

model FloorTable {
  id             String       @id @default(cuid())
  floorPlanId    String
  label          String
  shape          TableShape
  seats          Int
  seatLabelStyle String?
  x              Float
  y              Float
  width          Float
  height         Float
  rotation       Float
  section        TableSection
  minSpend       Int
  isReservable   Boolean
  floorPlan      FloorPlan    @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)

  @@index([floorPlanId])
  @@index([floorPlanId, section])
}

model FloorChair {
  id          String    @id @default(cuid())
  venueId     String
  floorPlanId String
  x           Float
  y           Float
  rotation    Float
  label       String?
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)

  @@index([floorPlanId])
  @@index([venueId])
}

model TableState {
  id             String      @id @default(cuid())
  venueId        String
  tableId        String
  status         TableStatus
  partySize      Int?
  serverId       String?
  toastCheckGuid String?
  seatedAt       DateTime?
  lastActivityAt DateTime
  notes          String?
  mergeGroupId   String?
  venue          Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([tableId])
  @@index([status])
  @@index([serverId])
  @@index([venueId])
  @@index([venueId, mergeGroupId])
}

model TableAssignment {
  id             String    @id @default(cuid())
  venueId        String
  reservationId  String?
  waitlistId     String?
  tableId        String
  holdType       HoldType
  startsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime  @default(now())
  releasedAt     DateTime?
  releasedReason String?
  venue          Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([tableId, startsAt])
  @@index([reservationId])
  @@index([waitlistId])
  @@index([venueId, startsAt])
}

model PosConnection {
  id                 String            @id @default(cuid())
  venueId            String
  provider           PosProvider
  externalLocationId String?
  status             IntegrationStatus
  webhookSecret      String?
  lastSyncAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  venue              Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([venueId, provider])
}

model PosCheck {
  id              String         @id @default(cuid())
  venueId         String
  provider        PosProvider
  externalCheckId String
  tableLabel      String?
  tableId         String?
  serverName      String?
  serverId        String?
  guestName       String?
  guestId         String?
  openedAt        DateTime
  closedAt        DateTime?
  subtotalCents   Int
  taxCents        Int?
  tipCents        Int
  totalCents      Int
  discountCents   Int?
  compCents       Int?
  promoCents      Int?
  guestCount      Int?
  revenueCenter   String?
  tenderType      String?
  menuItems       Json?
  status          PosCheckStatus
  raw             Json?
  updatedAt       DateTime       @updatedAt
  venue           Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Unique so retried/at-least-once POS webhook deliveries cannot insert
  // duplicate checks and double-count revenue.
  @@unique([venueId, provider, externalCheckId])
  @@index([venueId, openedAt])
  @@index([provider, externalCheckId])
  @@index([guestId])
}

model PosLaborPunch {
  id                 String      @id @default(cuid())
  venueId            String
  provider           PosProvider
  externalEmployeeId String
  employeeName       String
  jobTitle           String?
  clockInAt          DateTime
  clockOutAt         DateTime?
  regularMinutes     Int?
  overtimeMinutes    Int?
  declaredTipsCents  Int?
  tipsCents          Int?
  regularPayCents    Int?
  overtimePayCents   Int?
  totalPayCents      Int?
  businessDate       String
  updatedAt          DateTime    @updatedAt
  venue              Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Unique so retried/at-least-once labor webhook deliveries upsert one row per
  // employee per business day instead of double-counting hours and pay.
  @@unique([venueId, provider, externalEmployeeId, businessDate])
  @@index([venueId, businessDate])
  @@index([venueId, externalEmployeeId])
}

model CrmLead {
  id                  String        @id @default(cuid())
  venueId             String
  guestId             String?
  fullName            String
  email               String?
  phone               String?
  company             String?
  source              String?
  status              CrmLeadStatus
  tags                String[]
  assignedToId        String?
  marketingOptIn      Boolean?
  lastActivityAt      DateTime?
  estimatedValueCents Int?
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  venue               Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  notes               CrmNote[]
  beos                CrmBeo[]
  contracts           CrmContract[]

  @@index([venueId])
  @@index([venueId, status])
  @@index([guestId])
}

model CrmNote {
  id        String   @id @default(cuid())
  venueId   String
  leadId    String
  authorId  String
  text      String
  createdAt DateTime @default(now())
  lead      CrmLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author    Profile  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([venueId])
}

model CrmBeo {
  id                  String    @id @default(cuid())
  venueId             String
  leadId              String?
  eventName           String
  eventDate           DateTime?
  eventType           String?
  guestCount          Int?
  venueSpace          String?
  setupStyle          String?
  fbMinimumCents      Int?
  depositCents        Int?
  depositDueDate      DateTime?
  menuAppetizers      String?
  menuEntrees         String?
  menuDesserts        String?
  menuBarPackage      String?
  specialRequirements String?
  internalNotes       String?
  assignedRepId       String?
  status              BeoStatus
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  venue               Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  lead                CrmLead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([venueId])
  @@index([leadId])
  @@index([venueId, status])
}

model CrmContract {
  id                  String         @id @default(cuid())
  venueId             String
  leadId              String?
  beoId               String?
  contractNumber      String
  contractDate        DateTime?
  eventName           String?
  eventDate           DateTime?
  guestCount          Int?
  venueSpace          String?
  fbMinimumCents      Int?
  paymentSchedule     Json
  cancellationPolicy  String?
  forceMajeure        Boolean?
  liabilityWaiver     Boolean?
  customClauses       String[]
  clientSignatureName String?
  clientSignatureDate DateTime?
  status              ContractStatus
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  venue               Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  lead                CrmLead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([contractNumber])
  @@index([venueId])
  @@index([leadId])
  @@index([beoId])
  @@index([venueId, status])
}

model CrmActivityLog {
  id        String   @id @default(cuid())
  venueId   String
  leadId    String
  actorId   String?
  kind      String
  detail    String?
  createdAt DateTime @default(now())
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([venueId, createdAt])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  venueId   String
  name      String
  subject   String
  body      String
  // Comma-separated list of variables consumed by this template, e.g.
  // "guest.name,event.date". Used only for the UI hint; rendering looks up
  // {{name}}/{{event.date}} dynamically from the substitution context.
  variables String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, name])
  @@index([venueId])
}

model Subscription {
  id                     String                @id @default(cuid())
  venueId                String
  status                 SubscriptionStatus
  platform               SubscriptionPlatform?
  planId                 String
  priceCents             Int
  currency               String
  trialStartedAt         DateTime
  trialEndsAt            DateTime
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean
  cancelledAt            DateTime?
  externalSubscriptionId String?
  externalCustomerId     String?
  dataRetentionWarnedAt  DateTime?
  lastStripeEventAt      DateTime?
  lastRevenueCatEventAt  DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  venue                  Venue                 @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([status])
  @@index([externalSubscriptionId])
  @@index([externalCustomerId])
}

model SubscriptionEvent {
  id              String    @id @default(cuid())
  venueId         String
  source          String
  externalEventId String
  eventType       String
  payload         Json
  processedAt     DateTime?
  status          String
  errorMessage    String?

  @@unique([source, externalEventId])
  @@index([venueId, processedAt])
}

model PaymentMethod {
  id                    String   @id @default(cuid())
  venueId               String
  stripePaymentMethodId String
  brand                 String
  last4                 String
  expMonth              Int
  expYear               Int
  isDefault             Boolean
  createdAt             DateTime @default(now())
  venue                 Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model Invoice {
  id               String    @id @default(cuid())
  venueId          String
  // Unique so retried Stripe invoice webhooks upsert one row per invoice.
  stripeInvoiceId  String    @unique
  amountCents      Int
  currency         String
  status           String
  invoiceUrl       String?
  hostedInvoiceUrl String?
  periodStart      DateTime
  periodEnd        DateTime
  createdAt        DateTime  @default(now())
  paidAt           DateTime?
  venue            Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, createdAt])
}

model CosmicInsight {
  id      String   @id @default(cuid())
  kind    String
  title   String
  body    String
  batchAt DateTime

  @@index([batchAt])
}

model VenueRole {
  id      String @id @default(cuid())
  venueId String
  name    String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model Team {
  id          String @id @default(cuid())
  venueId     String
  name        String
  memberCount Int
  venue       Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model ScheduleEmailEvent {
  id        String   @id @default(cuid())
  venueId   String
  profileId String
  shiftId   String?
  kind      String
  email     String
  subject   String
  sentAt    DateTime
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, sentAt])
  @@index([profileId, sentAt])
}

model PayrollExport {
  id          String   @id @default(cuid())
  venueId     String
  provider    String
  periodStart DateTime
  periodEnd   DateTime
  rowCount    Int
  totalHours  Float
  createdBy   String
  createdAt   DateTime @default(now())
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, createdAt])
}

model ReservationConnection {
  id              String            @id @default(cuid())
  venueId         String
  provider        ReservationSource
  externalVenueId String?
  status          IntegrationStatus
  webhookSecret   String?
  lastSyncAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  venue           Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([venueId, provider])
}

model ReservationSyncEvent {
  id              String            @id @default(cuid())
  venueId         String
  provider        ReservationSource
  externalEventId String
  eventType       String
  reservationId   String?
  payload         Json
  processedAt     DateTime
  status          String
  errorMessage    String?
  venue           Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Unique so an at-least-once reservation webhook can be deduped: re-deliveries
  // of the same provider event are recognized and skipped.
  @@unique([venueId, provider, externalEventId])
  @@index([provider, externalEventId])
  @@index([venueId, processedAt])
}

model BarInventoryItem {
  id            String           @id @default(cuid())
  venueId       String
  name          String
  category      BarStockCategory
  area          String?
  unit          String
  parLevel      Float
  onHand        Float
  unitCostCents Int?
  supplier      String?
  sku           String?
  notes         String?
  lastCountedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  venue         Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([venueId, category])
  @@index([venueId, name])
}

model BarInventoryMovement {
  id             String               @id @default(cuid())
  venueId        String
  itemId         String
  movementType   BarStockMovementType
  quantity       Float
  previousOnHand Float
  nextOnHand     Float
  notes          String?
  createdBy      String
  createdAt      DateTime             @default(now())
  venue          Venue                @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, createdAt])
  @@index([itemId, createdAt])
}

model ManagerGoal {
  id          String            @id @default(cuid())
  venueId     String
  title       String
  details     String?
  period      ManagerGoalPeriod
  targetDate  String
  status      ManagerGoalStatus
  createdBy   String
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  venue       Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, targetDate])
  @@index([venueId, status])
}

model VenueEvent {
  id             String    @id @default(cuid())
  venueId        String
  title          String
  startsAt       DateTime
  endsAt         DateTime?
  expectedGuests Int?
  notes          String?
  reservationId  String?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  venue          Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, startsAt])
  @@index([reservationId])
}

model ReservationSetting {
  id                   String   @id @default(cuid())
  venueId              String
  defaultDiningMinutes Int
  defaultTurnMinutes   Int
  bookingWindowDays    Int
  minLeadHours         Int
  updatedAt            DateTime @updatedAt
  venue                Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model TableStateHistory {
  id         String      @id @default(cuid())
  venueId    String
  tableId    String
  fromStatus TableStatus
  toStatus   TableStatus
  actorId    String?
  partySize  Int?
  timestamp  DateTime
  metadata   Json?
  venue      Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([tableId, timestamp])
  @@index([venueId, timestamp])
}

model Invite {
  id        String   @id @default(cuid())
  venueId   String
  email     String?
  phone     String?
  token     String   @unique
  // Short, human-typeable join code (e.g. "VW-7K2Q9"); employees enter this to
  // join a team. The long `token` backs the venuewrangler://join deep link.
  code      String?  @unique
  role      Role
  jobTitle  String
  createdBy String
  usedBy    String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([phone])
  @@index([venueId])
}

model WorkplaceJoinRequest {
  id           String                      @id @default(cuid())
  venueId      String
  userId       String
  status       WorkplaceJoinRequestStatus  @default(pending)
  decidedAt    DateTime?
  decidedById  String?
  decisionNote String?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  venue        Venue                       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  events       WorkplaceJoinRequestEvent[]

  @@index([venueId])
  @@index([userId])
  @@index([status])
  @@index([venueId, status])
}

model WorkplaceJoinRequestEvent {
  id        String               @id @default(cuid())
  requestId String
  actorId   String?
  eventType String
  payload   Json?
  createdAt DateTime             @default(now())
  request   WorkplaceJoinRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
