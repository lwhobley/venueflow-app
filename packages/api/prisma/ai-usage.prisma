// Server-owned AI metering table created by 20260808134500_ai_usage_metering.
// The venue/profile foreign keys are enforced by that SQL migration. They are
// intentionally kept as scalar IDs here because the legacy Venue and Profile
// models live in schema.prisma; adding cross-file back-relations would require
// rewriting that large legacy schema. Do not remove the SQL foreign keys when
// generating future migrations.
model AiUsageEvent {
  id                  String   @id
  venueId             String
  profileId           String?
  feature             String
  provider            String
  model               String
  promptTokens        Int      @default(0)
  completionTokens    Int      @default(0)
  cachedTokens        Int      @default(0)
  totalTokens         Int      @default(0)
  estimatedCostMicros Int      @default(0)
  createdAt           DateTime @default(now())

  @@index([venueId, createdAt])
  @@index([venueId, feature, createdAt])
  @@index([profileId, createdAt])
}
