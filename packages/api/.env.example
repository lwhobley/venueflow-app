# Railway Postgres connection used by the running API and Prisma migrations.
# In Railway, set this to the Postgres plugin's DATABASE_URL reference.
DATABASE_URL="postgresql://postgres:password@host.railway.internal:5432/railway"

JWT_SECRET="replace-me-with-a-long-random-secret"
REVENUECAT_WEBHOOK_SECRET="replace-me-with-a-long-random-token"
REVENUECAT_API_KEY="replace-me-with-revenuecat-secret-api-key"
# Stripe webhook signing secret (Dashboard > Developers > Webhooks). Required
# for POST /api/v1/billing/stripe/webhook; the endpoint fails closed without it.
STRIPE_WEBHOOK_SECRET="whsec_..."
API_PORT=4000
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"

# Transactional email delivery through Resend.
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Venue Wrangler <no-reply@venuewrangler.com>"

# OpenAI API Key (optional, for bar inventory AI parsing)
OPENAI_API_KEY="sk-proj_..."

# AWS S3 — required for chat image uploads. S3ImageService calls getOrThrow on
# these at boot, so the API will not start without them. Bucket should be
# private; images are served via presigned URLs.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="replace-me"
AWS_S3_BUCKET="venuewrangler-chat-images"

# Max JSON request body size. Must exceed the base64-encoded image size
# (~6.7MB for a 5MB image). Defaults to 8mb if unset.
JSON_BODY_LIMIT="8mb"
