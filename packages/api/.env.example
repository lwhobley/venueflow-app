# Railway Postgres connection used by the running API and Prisma migrations.
# In Railway, set this to the Postgres plugin's DATABASE_URL reference.
DATABASE_URL="postgresql://postgres:password@host.railway.internal:5432/railway"

JWT_SECRET="replace-me-with-a-long-random-secret"
REVENUECAT_WEBHOOK_SECRET="replace-me-with-a-long-random-token"
API_PORT=4000
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"

# OpenAI API Key (optional, for bar inventory AI parsing)
OPENAI_API_KEY="sk-proj_..."
