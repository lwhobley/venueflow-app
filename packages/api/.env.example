# Neon pooled connection (PgBouncer) — used by the running API
# Format: postgresql://<user>:<password>@<host>/<db>?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Neon direct connection — used by prisma migrate / prisma studio (NOT the pooler)
# Same as above but without the pgbouncer param and using the direct host
DATABASE_DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET="replace-me-with-a-long-random-secret"
API_PORT=4000
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"
