# Railway Postgres — copy DATABASE_PUBLIC_URL from your Railway Postgres service for local dev
# In production Railway injects DATABASE_URL automatically via the service link
DATABASE_URL="postgresql://postgres:password@monorail.proxy.rlwy.net:12345/railway"

JWT_SECRET="replace-me-with-a-long-random-secret"
API_PORT=4000
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"

# Convex site URL — needed to verify RS256 JWT tokens issued by Convex auth
CONVEX_SITE_URL="https://your-deployment.convex.cloud"
