{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "https://dashing-eel-31.convex.cloud",
        "EXPO_PUBLIC_BILLING_ENABLED": "false"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "https://dashing-eel-31.convex.cloud",
        "EXPO_PUBLIC_CONVEX_SITE_URL": "https://dashing-eel-31.convex.site",
        "EXPO_PUBLIC_BILLING_ENABLED": "false"
      },
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
